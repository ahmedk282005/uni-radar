# Copy this file to .env and fill in your own values (.env is git-ignored).
# Both values come from the Supabase dashboard: Connect dialog, or Settings > API Keys.
# EXPO_PUBLIC_ variables are bundled into the app, so only public values belong here:
# the publishable key (sb_publishable_...) — NEVER the secret key (sb_secret_...) or the database password.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
